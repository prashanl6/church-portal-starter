# PostgreSQL (Prisma). Examples:
# Local: postgresql://postgres:postgres@localhost:5432/church_portal?schema=public
# Neon / Vercel Postgres often need: ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/church_portal?schema=public"

# JWT Secret. REQUIRED in production: 16+ random characters (e.g. `openssl rand -hex 32`).
# Without it nobody can log in (the old built-in fallback secret was unsafe).
JWT_SECRET="your-secret-key-here"

# Optional: one-time first admin creation when User table is empty (POST /api/auth/bootstrap).
# Remove from Vercel env after you have created an admin.
# BOOTSTRAP_ADMIN_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=church.office@example.com
SMTP_PASS=your-app-password-here
FROM_EMAIL=church.office@example.com
FROM_NAME=Church Portal

# Base URL for email links
NEXT_PUBLIC_BASE_URL=http://localhost:3001
BASE_URL=http://localhost:3001

# Cron: booking auto-cancel (set in production; Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# IANA timezone for hall booking start times (payment deadline = start − 1 hour in this zone)
BOOKING_TIMEZONE=Asia/Colombo
